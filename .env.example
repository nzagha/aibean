# Copy missing settings to .env.local; never overwrite an existing private file.
# Authoritative hosted development project. Retrieve keys/DB URL from its dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://yfknxidgphhepdtwazhn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
DATABASE_CA_CERT_PATH=
# Disposable local PostgreSQL only; unrelated to hosted Supabase Auth.
# Local URL example: postgresql://aibean:<local-password>@127.0.0.1:54329/aibean
POSTGRES_PASSWORD=choose-a-local-password
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Temporary email/password login; configure the hash with scripts/configure-password-login.ts.
# Transitional preview only. Supabase cutover awaits validated identity migration.
AIBEAN_AUTH_MODE=password
# Candidate only: configure in a separate loopback test deployment after approval.
# These blank gates never change the currently active identity provider.
AIBEAN_SUPABASE_RELEASE=
AIBEAN_AUTH_ISOLATED=
AIBEAN_SUPABASE_PROVIDER_TEST_APPROVED=
# Private random 64+ character value; configure privately, never paste in chat.
AIBEAN_RECOVERY_SECRET=
LOCAL_LOGIN_EMAIL=
LOCAL_LOGIN_PASSWORD_HASH=
LOCAL_SESSION_SECRET=
# Explicit local demonstration data; turn off before a real launch.
AIBEAN_DEMO_MODE=true
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Operator-configured test-mode claim price. No fees are assumed.
STRIPE_CLAIM_PRICE_ID=
# Fixed one-time TEST price: 9900 minor units, USD ($99 for 5 days).
# Featured checkout is independent of the claim price.
STRIPE_FEATURED_PRICE_ID=
# Enable only after separately approved admin-review-v1 installation/validation.
AIBEAN_REVIEW_WORKFLOWS=
AIBEAN_COMMERCE_WORKFLOWS=
# Explicit private launch promotion; applies only to newly requested verification.
# Does not waive paid edits or grant aiBean Verified.
AIBEAN_VERIFICATION_PROMO_ZERO=

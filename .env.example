# Copy to .env.local; never commit credentials. Docker is bound to localhost.
POSTGRES_PASSWORD=choose-a-local-password
DATABASE_URL=postgresql://aibean:choose-a-local-password@127.0.0.1:54329/aibean
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Temporary email/password login; configure the hash with scripts/configure-password-login.ts.
# Set AIBEAN_AUTH_MODE=clerk in a later version to use the configured provider instead.
AIBEAN_AUTH_MODE=password
LOCAL_LOGIN_EMAIL=
LOCAL_LOGIN_PASSWORD_HASH=
LOCAL_SESSION_SECRET=
# Explicit local demonstration data; turn off before a real launch.
AIBEAN_DEMO_MODE=true
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Operator-configured test-mode claim price. No fees are assumed.
STRIPE_CLAIM_PRICE_ID=
# Fixed one-time TEST price: 9900 minor units, USD ($99 for 5 days).
# Featured checkout is independent of the claim price.
STRIPE_FEATURED_PRICE_ID=

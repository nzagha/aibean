          "value": "\"featured_placements\".\"status\" NOT IN ('active','suspended') OR (\"featured_placements\".\"paid_at\" IS NOT NULL AND \"featured_placements\".\"starts_at\" IS NOT NULL AND \"featured_placements\".\"ends_at\" IS NOT NULL AND \"featured_placements\".\"ends_at\" > \"featured_placements\".\"starts_at\" AND \"featured_placements\".\"amount\" IS NOT NULL AND \"featured_placements\".\"duration_days\" IS NOT NULL)"
        }
